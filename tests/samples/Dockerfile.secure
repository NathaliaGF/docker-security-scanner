# ✅ SECURE example — demonstrates Dockerfile hardening best practices.

# Pinned, current, non-EOL base image.
FROM python:3.12-slim

WORKDIR /app

# Copy only the dependency manifest first (layer caching).
COPY requirements.txt .

# Single RUN: update, install with --no-install-recommends, clean up in one layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -r requirements.txt

# Copy only the application source (not the entire context).
COPY src/ ./src/

# Non-privileged application port.
EXPOSE 8080

# Create and switch to a non-root user before the final entry point.
RUN groupadd -r appuser && useradd --no-log-init -r -g appuser appuser
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["python", "src/app.py"]
